{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroSpace",
  "version": "0.1.0",
  "identifier": "dev.zer0spce.zerospace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZeroSpace",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "shortDescription": "All-in-one Windows toolkit for PS5",
    "longDescription": "PS5 file management and direct archive-to-FTP transfers."
  }
}
